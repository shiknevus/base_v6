{
    // 彻底关闭代码折叠
    "editor.folding": false,
    "editor.foldingHighlight": false,
    "editor.showFoldingControls": "never",
    "editor.foldingImportsByDefault": false,
    "editor.foldingStrategy": "indentation",
    "editor.hideCursorInOverviewRuler": true,
    // 彻底关闭所有自动语义染色
    "editor.semanticHighlighting.enabled": false,
    "editor.semanticTokenColorCustomizations": false,
    "editor.bracketPairColorization.enabled": false,
    "editor.guides.bracketPairs": false,
    "editor.language.colorizedBracketPairs": false,
    // 界面基础
    "workbench.colorTheme": "Dark Modern",
    "editor.background": "#000000",
    "editor.fontSize": 16,
    "editor.lineHeight": 1.6,
    "editor.fontFamily": "Consolas, Monaco, Menlo, monospace",
    "editor.tokenColorCustomizations": {
        "comments": "#009900",
        "numbers": "#AAAAAA",
        "strings": "#AAAAAA",
        "textMateRules": [
            // 语法关键字 再次提亮黄色 #E6C800
            {
                "scope": [
                    "keyword.control.verilog",
                    "storage.type.verilog",
                    "keyword.operator.verilog",
                    "entity.name.type.module.verilog",
                    "meta.preprocessor.verilog",
                    "punctuation.verilog"
                ],
                "settings": {
                    "foreground": "#E6C800"
                }
            },
            // 所有变量、信号名 #B4B4B4
            {
                "scope": [
                    "variable.other.verilog",
                    "variable.parameter.verilog",
                    "variable.other.global.verilog",
                    "entity.name.label.verilog",
                    "variable.other"
                ],
                "settings": {
                    "foreground": "#B4B4B4"
                }
            },
            // 兜底同步提亮黄色
            {
                "scope": "source.verilog",
                "settings": {
                    "foreground": "#E6C800"
                }
            }
        ]
    },
    "workbench.set