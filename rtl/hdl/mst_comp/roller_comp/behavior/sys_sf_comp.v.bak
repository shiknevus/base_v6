module sys_sf_comp
(
     input wire                        clk
    ,input wire                        reset
    
    ,input wire                        sy_estop
    ,input wire                        sy_reset
    ,input wire                        sy_stop
    ,input wire                        sy_start
    ,output wire                       sy_r
    ,output wire                       sy_y
    ,output wire                       sy_g
    ,output wire                       sy_bz
    
    ,input wire                        sy_error
    ,output reg                        clear_err
);

    localparam SYS_PAUSE    = 2'd0;
    localparam SYS_RUN      = 2'd1;
    localparam SYS_ERR      = 2'd2;
    localparam SYS_JERK     = 2'd3; 
    localparam WHOLE_VALUE  = 150000000;
    localparam DUTY_VALUE   = WHOLE_VALUE/2;
    localparam TIME_WIDTH   = $clog2(WHOLE_VALUE);
    reg [TIME_WIDTH-1:0] time_cnt;
    reg [1:0] sys_state;
    reg aclk_r;
    wire sy_reset_en;
    wire sy_stop_en;
    wire sy_start_en;

    assign sy_r = ((sys_state == SYS_ERR) || (sys_state == SYS_JERK)) ? 1 : 0;
    assign sy_y = (sys_state == SYS_PAUSE) ? 1 : 0;
    assign sy_g = (sys_state == SYS_RUN) ? 1 : 0;
    assign sy_bz = (sys_state == SYS_JERK) ? 1 : ((sys_state == SYS_ERR) ? aclk_r : 0);
    
    always @(posedge clk)begin
        if(reset)begin
            time_cnt <= 'b0;
        end else begin
            time_cnt <= (time_cnt < WHOLE_VALUE-1) ? (time_cnt + 1'b1) : 1'b0;
        end
    end

    always @(posedge clk)begin
        if(reset)begin
            aclk_r <= 1'b0;
        end else begin
            aclk_r <= (time_cnt <= DUTY_VALUE-1) ? 1'b1 : 1'b0;
        end
    end
    

    always @(posedge clk)begin
        if(reset)begin
            sys_state <= SYS_PAUSE;
        end else if(sy_estop) begin
            sys_state <= SYS_JERK; 
        end else if(sy_error && sys_state != SYS_JERK) begin
            sys_state <= SYS_ERR;        
        end else if((sy_stop_en && sys_state == SYS_RUN) || (sy_reset_en && sys_state == SYS_ERR) || (~sy_estop && sys_state == SYS_JERK)) begin
            sys_state <= SYS_PAUSE;
        end else if(sy_start_en && sys_state == SYS_PAUSE) begin
            sys_state <= SYS_RUN;
        end   
    end
    
    button_debounce button_debounce_u1
    (
        .clk                (clk            )
        ,.reset             (reset          )
    
        ,.button_in         (sy_reset       )
        ,.button_posedge    (sy_reset_en    )
        ,.button_negedge    (               )
        ,.button_out        (               )
    );
    
    button_debounce button_debounce_u2
    (
        .clk                (clk            )
        ,.reset             (reset          )
    
        ,.button_in         (sy_stop        )
        ,.button_posedge    (sy_stop_en     )
        ,.button_negedge    (               )
        ,.button_out        (               )
    );
    
    button_debounce button_debounce_u3
    (
        .clk                (clk            )
        ,.reset             (reset          )
    
        ,.button_in         (sy_start       )
        ,.button_posedge    (sy_start_en    )
        ,.button_negedge    (               )
        ,.button_out        (               )
    );

endmodule